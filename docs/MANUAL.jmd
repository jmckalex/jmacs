<script data-type="jmarkdown">
  // The cross-link helper. After this <script>, any `cmd(name)` written
  // in markdown body text (inline) expands to an <a> with both the
  // relative href (for browser use) and a data-jmacs-doc attribute
  // (intercepted by the editor's doc-view). The function entries below
  // each declare their own `path`; this helper assumes the convention
  // `reference/commands/<name>.html`. For names whose path doesn't
  // follow the convention, write the anchor by hand.
  global.cmd = function (name) {
    return `<a href="reference/commands/${name}.html" data-jmacs-doc="${name}">${name}</a>`;
  };
  export_to_jmarkdown('cmd');
</script>

<script data-type="jmarkdown-postprocess">
  // Split the rendered document into per-function pages and write the
  // name → path manifest. The output directory is passed in by
  // scripts/build-docs.js via the JMACS_DOCS_OUT env var (default
  // 'docs/build' when run directly).
  //
  // Collisions: two different functions can share a short name (a
  // primitive vs a command — e.g. `newline`). For each name with
  // multiple entries the manifest carries every qualified
  // `<tier>:<name>` form *and* a bare-name form pointing at the
  // preferred tier. PREFERRED_TIERS below decides who wins the bare
  // form: commands first (the user-facing layer), then lisp-core,
  // then buffer-primitives. The qualified forms surface in the
  // fuzzy search so callers can still reach either page.
  const fs = require('node:fs');
  const path = require('node:path');
  const outDir = process.env.JMACS_DOCS_OUT || 'docs/build';
  const PREFERRED_TIERS = ['commands', 'lisp-core', 'buffer-primitives'];
  // Tier inferred from path: reference/<tier>/<name>.html — anything
  // outside this shape goes into the catch-all bucket 'other'.
  function tierOfPath(p) {
    const m = /^reference\/([^/]+)\//.exec(p);
    return m ? m[1] : 'other';
  }
  const entries = []; // { name, path, tier }
  const seenNames = new Map(); // name → [{ path, tier }, …]
  function note(name, target) {
    const tier = tierOfPath(target);
    entries.push({ name, path: target, tier });
    if (!seenNames.has(name)) seenNames.set(name, []);
    seenNames.get(name).push({ path: target, tier });
  }
  $('function').each((_, el) => {
    const $el = $(el);
    const name = $el.attr('name');
    const target = $el.attr('path');
    if (!name || !target) return;
    const aliasAttr = $el.attr('aliases') || '';
    const aliases = aliasAttr.split(/\s+/).filter(Boolean);
    const file = path.join(outDir, target);
    fs.mkdirSync(path.dirname(file), { recursive: true });
    const depth = target.split('/').length - 1;
    const cssHref = '../'.repeat(depth) + 'assets/docs.css';
    const fragment = $el.html();
    const html = `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>${name} — jmacs</title>
<link rel="stylesheet" href="${cssHref}">
</head>
<body>
<article class="doc-page function-page" data-jmacs-doc-name="${name}">
${fragment}
</article>
</body>
</html>`;
    fs.writeFileSync(file, html);
    note(name, target);
    for (const alias of aliases) note(alias, target);
  });
  const manifest = {};
  for (const [name, hits] of seenNames.entries()) {
    if (hits.length === 1) {
      manifest[name] = hits[0].path;
      continue;
    }
    // Multiple tiers for the same bare name: every tier gets a
    // qualified entry; the preferred tier wins the bare name.
    for (const hit of hits) manifest[`${hit.tier}:${name}`] = hit.path;
    const preferred =
      hits.find((h) => PREFERRED_TIERS.indexOf(h.tier) >= 0) ?? hits[0];
    const ranked = [...hits].sort((a, b) => {
      const ai = PREFERRED_TIERS.indexOf(a.tier);
      const bi = PREFERRED_TIERS.indexOf(b.tier);
      return (ai < 0 ? PREFERRED_TIERS.length : ai)
        - (bi < 0 ? PREFERRED_TIERS.length : bi);
    });
    manifest[name] = ranked[0].path;
    console.error(
      `build-docs: name "${name}" appears in ${hits.length} tiers (` +
      hits.map((h) => h.tier).join(', ') +
      `); bare form resolves to ${ranked[0].tier}.`
    );
  }
  fs.mkdirSync(outDir, { recursive: true });
  fs.writeFileSync(
    path.join(outDir, 'manifest.json'),
    JSON.stringify(manifest, null, 2)
  );
  console.error(`build-docs (postprocess): wrote ${Object.keys(manifest).length} function page(s)`);
</script>
