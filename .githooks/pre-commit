#!/usr/bin/env bash
# Pre-commit hook: protects main branch and runs tests before commit.
# Install with: git config core.hooksPath .githooks

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[0;33m'
GREEN='\033[0;32m'
NC='\033[0m'

# Detect the initial commit (no HEAD yet). The initial commit gets a pass on
# branch checks and test running, since there's no codebase to test and the
# branch protection isn't meaningful yet.
if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
  echo -e "${GREEN}Initial commit detected. Skipping pre-commit checks.${NC}"
  exit 0
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Block direct commits to main or master.
if [[ "$BRANCH" == "main" || "$BRANCH" == "master" ]]; then
  echo -e "${RED}ERROR:${NC} Direct commits to '$BRANCH' are not allowed."
  echo "Create a branch first:"
  echo "  git checkout -b agent-N-description"
  echo ""
  echo "If you really need to commit to $BRANCH (rare), bypass with:"
  echo "  git commit --no-verify"
  exit 1
fi

# Warn if committing on a branch that doesn't match the conventions.
# Accepted forms (see CLAUDE.md):
#   agent-N-description            e.g. agent-1-storage
#   agent-N-description/subtask    e.g. agent-2-buffer/markers
#   agent-N                        bare role branch
#   architect, architect/something
#   fix/..., feature/..., docs/..., spike/...
#   main, master
if [[ ! "$BRANCH" =~ ^(agent-[0-9]+(-[a-z0-9-]+)?|architect|fix|feature|docs|spike)/ ]] && \
   [[ ! "$BRANCH" =~ ^(agent-[0-9]+(-[a-z0-9-]+)?|architect|main|master)$ ]]; then
  echo -e "${YELLOW}WARNING:${NC} Branch '$BRANCH' doesn't match expected naming convention."
  echo "Expected: agent-N-description, agent-N/subtask, architect/something, fix/something, etc."
  echo "Proceeding anyway. Bypass with --no-verify."
  echo ""
fi

# Run tests if a test script exists.
# Note: the flag goes before the script name so pnpm consumes it; an arg
# after the script name is forwarded to the script (and `node --test`
# rejects unknown flags).
if [[ -f "package.json" ]] && grep -q '"test"' package.json; then
  echo -e "${GREEN}Running tests before commit...${NC}"
  if ! pnpm --silent test 2>&1 | tail -20; then
    echo ""
    echo -e "${RED}ERROR:${NC} Tests failed. Commit blocked."
    echo "Fix tests, or bypass with --no-verify if you have a good reason."
    exit 1
  fi
  echo -e "${GREEN}Tests passed.${NC}"
fi

# Block accidentally committed sensitive files.
SENSITIVE_PATTERNS=(
  '\.env$'
  '\.env\..*'
  '.*\.pem$'
  '.*\.key$'
  'id_rsa'
  'id_ed25519'
  'secrets/'
)

STAGED_FILES=$(git diff --cached --name-only)
for pattern in "${SENSITIVE_PATTERNS[@]}"; do
  if echo "$STAGED_FILES" | grep -qE "$pattern"; then
    echo -e "${RED}ERROR:${NC} Staging file matching sensitive pattern: $pattern"
    echo "If intentional, bypass with --no-verify and consider whether the file should be in the repo."
    exit 1
  fi
done

# Warn about console.log left-behinds.
if git diff --cached --name-only | grep -qE '\.(js|mjs|jsx)$'; then
  if git diff --cached -- '*.js' '*.mjs' '*.jsx' | grep -qE '^\+.*console\.(log|debug)\('; then
    echo -e "${YELLOW}WARNING:${NC} Staged changes include console.log/debug additions."
    echo "Consider whether these should be removed before commit."
    echo "(Not blocking; commit will proceed.)"
    echo ""
  fi
fi

exit 0
